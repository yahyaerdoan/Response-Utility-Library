root = true

[*]
indent_style = space
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
end_of_line = crlf

# Required so the editor's "Organize Imports"/format-on-save agrees with StyleCop's SA1208
# (System.* usings before other namespaces). Without this, IDEs sort usings purely
# alphabetically, which puts e.g. ResultHandler.* before System.* and fails the build.
dotnet_sort_system_directives_first = true

# No blank line between the System.* and project-namespace using groups (matches existing
# single-block style throughout the codebase).
dotnet_separate_import_directive_groups = false

# Usings stay outside the (file-scoped) namespace declaration, matching every file today.
csharp_using_directive_placement = outside_namespace:warning

# Language conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion

# Naming: private/internal fields -> _camelCase
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Formatting
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true

# StyleCop.Analyzers / SonarAnalyzer.CSharp — rules disabled because they conflict with an
# established, deliberate project convention rather than because they're low-value in general.
# Everything else stays at its default severity and must build warning-free.

# CS1591 (missing XML doc on public member) is already suppressed project-wide (Directory.Build.props),
# so the StyleCop rules that police the *content* of doc comments would fight that decision.
dotnet_diagnostic.SA1600.severity = none # Elements should be documented
dotnet_diagnostic.SA1601.severity = none # Partial elements should be documented
dotnet_diagnostic.SA1602.severity = none # Enumeration items should be documented
dotnet_diagnostic.SA1604.severity = none # Element documentation should have summary
dotnet_diagnostic.SA1611.severity = none # Element parameters should be documented
dotnet_diagnostic.SA1615.severity = none # Element return value should be documented
dotnet_diagnostic.SA1618.severity = none # Generic type parameters should be documented
dotnet_diagnostic.SA1623.severity = none # Property summary documentation should match accessors
dotnet_diagnostic.SA1642.severity = none # Constructor summary documentation should begin with standard text

# No file-header convention in this project.
dotnet_diagnostic.SA1633.severity = none # File should have a header

# `IOperationResultOfT.cs` is the established file-naming workaround for the open generic
# type IOperationResult<T> (a literal "<T>" can't appear in a filename).
dotnet_diagnostic.SA1649.severity = none # File name should match first type name

# dotnet_style_qualification_for_* = false above already means "don't prefix with this.".
dotnet_diagnostic.SA1101.severity = none # Prefix local calls with this.

# Conflicts with the private/internal field naming rule below (leading underscore is intentional).
dotnet_diagnostic.SA1309.severity = none # Field name should not begin with underscore

# IOperationResult<T> could be made covariant (T only appears in getter/out positions), but widening
# a shipped public interface's variance is a deliberate API decision, not a mechanical style fix.
dotnet_diagnostic.S3246.severity = none # Add the 'out' keyword to make a type parameter covariant

# Matching the primary constructor's optional detail/errors defaults on the wider errors+fieldErrors
# constructor would make short calls ambiguous between the two - kept required-only on purpose.
dotnet_diagnostic.RS0027.severity = none # API with optional parameters should have the most parameters amongst its overloads

# Test code deliberately declares locals as the interface type in several places (e.g.
# IOperationResult result = new SuccessResult(...)) specifically to verify contract/annotation
# behavior (like [MemberNotNullWhen]) through the interface reference, not the concrete type — the
# exact opposite of what CA1859 assumes. Test methods also aren't perf-sensitive, so the "avoid
# virtual/interface call overhead" rationale doesn't apply here the way it does in library code.
[test/**/*.cs]
dotnet_diagnostic.CA1859.severity = none

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
