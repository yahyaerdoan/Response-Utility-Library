<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ResponseResultHandler.FluentValidation</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Response Result Handler - FluentValidation</Title>
    <Version>16.1.0</Version>
    <Product>ResponseResultHandler.FluentValidation</Product>
    <Description>FluentValidation integration for ResponseResultHandler: turns validation results into field-keyed failed results, and validates Minimal API and MVC requests into RFC 9457 validation Problem Details without MediatR.</Description>
    <PackageIcon>ResultHandlerIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fluentvalidation validation aspnetcore minimal-api mvc problem-details result-pattern</PackageTags>
    <PackageReleaseNotes>v16.1 - No changes in this package. Versions move together; see CHANGELOG.md.

v16.0 - No changes in this package. Versions move together; see CHANGELOG.md.

v15.0 - First release: ValidationResult.ToFieldErrors()/ToOperationResult()/ToFailure&lt;TResult&gt;(), WithResultValidation() for Minimal API endpoints and groups, AddResultValidation() for MVC. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>


  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ResultHandler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultHandler.AspNetCore\ResultHandler.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\ResultHandler\ResultHandlerIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

</Project>
